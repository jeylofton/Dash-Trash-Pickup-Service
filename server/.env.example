# ---------------------------------------------------------------
# Payments
#
# "demo" is the only working value today. It simulates a processor -
# no card is collected, no money moves, and outcomes are chosen from
# a fixed list (success/failed/declined/pending) rather than a real
# decline reason. See server/lib/payments/ to add a real provider.
#
# Copy this file to `.env` and fill it in. NEVER commit `.env`.
# ---------------------------------------------------------------
PAYMENT_PROVIDER=demo

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
PORT=3000
# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
