# =================================================================
# Dash Trash Pickup - environment configuration
#
# Copy this file to `.env` and fill it in:   cp .env.example .env
# NEVER commit the real `.env` - it is gitignored.
#
# Every value below has a safe default in code, so the app boots
# with an empty .env in development. Set them explicitly for
# production. No source file needs editing to configure any of this.
# =================================================================

# ---------------------------------------------------------------
# Environment
#
# "development" (default) enables live-reload and the demo-login
# hint. "production" turns both off, forces HTTPS, marks the
# session cookie Secure, and hides stack traces.
# ---------------------------------------------------------------
NODE_ENV=production

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
# The port to listen on. Many hosts assign their own via $PORT.
PORT=3000

# Cross-origin API callers. The app serves its own frontend from
# the same origin, so this is normally EMPTY in production. Only
# set it if a separate frontend origin must call this API.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------
# Database (SQLite, built into Node - no server to run)
#
# Absolute or relative path to the database file. Defaults to
# server/data/dash.db. Point this at a persistent volume in
# production so data survives restarts and redeploys.
# ---------------------------------------------------------------
DB_PATH=

# ---------------------------------------------------------------
# Photo / file storage
# ---------------------------------------------------------------
# "local" (default) writes to disk. An "s3" driver seam exists in
# lib/storage.js for S3/R2/any S3-compatible bucket (not yet wired).
STORAGE_DRIVER=local

# Where the local driver writes uploads. Defaults to server/data/uploads.
# Point this at a persistent volume in production.
UPLOAD_DIR=

# Max bytes per uploaded photo (default 8 MB).
MAX_UPLOAD_BYTES=

# ---------------------------------------------------------------
# Payments
#
# "demo" is the only working value today. It simulates a processor:
# no card is collected, no money moves, and the outcome is chosen
# from a fixed list (success/failed/declined/pending). See
# server/lib/payments/ to add a real provider.
# ---------------------------------------------------------------
PAYMENT_PROVIDER=demo

# ---------------------------------------------------------------
# Encryption
#
# 32-byte key (64 hex chars) for AES-256-GCM encryption of
# sensitive data (banking info). Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Banking endpoints will refuse to store data without this key.
# ---------------------------------------------------------------
ENCRYPTION_KEY=

# ---------------------------------------------------------------
# Real payment provider (RESERVED - not read yet)
#
# When a real provider is added behind the payments seam, it will
# read its credentials from here. Leave blank while on "demo".
# ---------------------------------------------------------------
# PAYMENT_PUBLIC_KEY=
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------
# Public site URL (RESERVED - not read yet)
#
# The canonical/OG URLs currently live in index.html. This is here
# for the planned first-run setup, which will let the owner set the
# public URL without editing source.
# ---------------------------------------------------------------
# APP_URL=https://example.com

# ---------------------------------------------------------------
# Development only
#
# Set DEV_RELOAD=0 to disable browser live-reload while developing.
# Ignored entirely when NODE_ENV=production.
# ---------------------------------------------------------------
# DEV_RELOAD=0
