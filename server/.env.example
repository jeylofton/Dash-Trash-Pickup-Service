# ---------------------------------------------------------------
# Square credentials
# Get these from https://developer.squareup.com/apps
#
# Copy this file to `.env` and fill it in. NEVER commit `.env`.
# ---------------------------------------------------------------

# "sandbox" while testing, "production" when you go live
SQUARE_ENVIRONMENT=sandbox

# Server-side only. This is a SECRET - it must never appear in browser code.
SQUARE_ACCESS_TOKEN=EAAA...your_sandbox_access_token

# These two ARE safe to send to the browser (the frontend needs them).
SQUARE_APPLICATION_ID=sandbox-sq0idb-...
SQUARE_LOCATION_ID=L...

# Square API version. Check the current one at
# https://developer.squareup.com/docs/build-basics/versioning-overview
SQUARE_VERSION=2025-01-23

# ---------------------------------------------------------------
# Subscription plan variation IDs
#
# Create these in Square Dashboard first (see README "Square setup").
# Each plan needs its own SUBSCRIPTION_PLAN_VARIATION catalog object.
# ---------------------------------------------------------------
SQUARE_PLAN_INTRODUCTORY=
SQUARE_PLAN_MONTHLY=
SQUARE_PLAN_QUARTERLY=
SQUARE_PLAN_ANNUAL=

# ---------------------------------------------------------------
# Webhook signature key (Square Dashboard -> Webhooks)
# Used to verify that webhook calls really came from Square.
# ---------------------------------------------------------------
SQUARE_WEBHOOK_SIGNATURE_KEY=
WEBHOOK_URL=https://your-domain.com/api/webhooks/square

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
PORT=3000
# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
