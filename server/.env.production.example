# ---------------------------------------------------------------
# PRODUCTION Square credentials - REAL MONEY
#
# Copy to `.env.production`, fill it in, then run:
#     node bin/square-setup.js --env=production
#
# This file configures the production catalog only. The server still
# reads `.env`. To go live, copy these values into `.env` and set
# SQUARE_ENVIRONMENT=production there.
#
# NEVER commit `.env.production`.
# ---------------------------------------------------------------

SQUARE_ENVIRONMENT=production

# Production access token. Square shows it once - store it in a password
# manager. It can charge real cards. Server-side only, never in browser code.
SQUARE_ACCESS_TOKEN=

# Safe to send to the browser.
SQUARE_APPLICATION_ID=sq0idp-...
# Leave blank and square-setup.js fills in your first location.
SQUARE_LOCATION_ID=

SQUARE_VERSION=2025-01-23

# ---------------------------------------------------------------
# Filled in automatically by `node bin/square-setup.js --env=production`.
# Leave blank.
# ---------------------------------------------------------------
SQUARE_PLAN_INTRODUCTORY=
SQUARE_PLAN_MONTHLY=
SQUARE_PLAN_QUARTERLY=
SQUARE_PLAN_ANNUAL=

# ---------------------------------------------------------------
# Webhooks. Production uses a separate subscription and a separate
# signature key from sandbox - they are not interchangeable.
# ---------------------------------------------------------------
SQUARE_WEBHOOK_SIGNATURE_KEY=
WEBHOOK_URL=https://your-domain.com/api/webhooks/square

PORT=3000
ALLOWED_ORIGINS=https://your-domain.com
